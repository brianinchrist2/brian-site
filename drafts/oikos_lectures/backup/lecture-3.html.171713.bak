  <div class="content center">
    <div class="fig r"><svg width="1620" height="620" viewBox="0 0 1620 620" role="img" aria-label="从无殿到有殿再到无殿：伊甸、会幕、圣殿、基督的身体、活石的殿、新城" style="--dstep:150ms"><g transform="translate(0 56)"><path d="M60 440C260 440 300 300 380 290S560 170 640 172S800 300 900 336S1080 440 1180 440L1570 440" class="ln ln-r w5 draw" pathLength="1" style="--dd:2.4s"/></g><g transform="translate(0 56)"><g class="pop" style="--d:2"><circle cx="110" cy="440" r="11" class="f-a"/><circle cx="110" cy="440" r="20" class="ln ln-a w2"/></g><g style="--d:3" class="fade"><g transform="translate(0 -26)"><path d="M110 432V370M110 400L88 378M110 388L130 366" class="ln ln-o w4 draw" pathLength="1"/><path d="M58 348Q50 290 98 288Q116 254 150 280Q184 300 162 336Q150 364 110 356Q70 370 58 348Z" class="ln ln-o w4 f-ot draw" pathLength="1"/></g></g><text x="110" y="504" text-anchor="middle" class="tx tx-b tx-s t36 fade" style="--d:3">伊甸</text><text x="110" y="544" text-anchor="middle" class="tx tx-f fade" style="--d:3">创 3:8</text><g class="pop" style="--d:4"><circle cx="380" cy="290" r="11" class="f-a"/><circle cx="380" cy="290" r="20" class="ln ln-a w2"/></g><g style="--d:5" class="fade"><g transform="translate(0 -26)"><path d="M322 276V216L380 172L438 216V276" class="ln ln-a w4 f-at draw" pathLength="1"/><path d="M350 276V194M380 276V172M410 276V194" class="ln ln-a w2 draw" pathLength="1"/><path d="M304 276H456" class="ln ln-a w4 draw" pathLength="1"/></g></g><text x="380" y="350" text-anchor="middle" class="tx tx-b tx-s t36 fade" style="--d:5">会幕</text><text x="380" y="390" text-anchor="middle" class="tx tx-f fade" style="--d:5">来 8:5</text><g class="pop" style="--d:6"><circle cx="640" cy="172" r="11" class="f-a"/><circle cx="640" cy="172" r="20" class="ln ln-a w2"/></g><g style="--d:7" class="fade"><g transform="translate(0 -26)"><path d="M570 102L640 60L710 102Z" class="ln w4 f-s draw" pathLength="1"/><path d="M586 106V152M622 106V152M658 106V152M694 106V152" class="ln w5 draw" pathLength="1"/><path d=