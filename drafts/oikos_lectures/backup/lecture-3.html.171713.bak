e cx="347" cy="496.6" r="7" class="f-a pop"/><circle cx="426" cy="493.1" r="7" class="f-a pop"/><circle cx="505" cy="486.2" r="7" class="f-a pop"/><circle cx="584" cy="472.5" r="7" class="f-a pop"/><circle cx="663" cy="445" r="7" class="f-a pop"/><circle cx="742" cy="390" r="7" class="f-a pop"/><circle cx="821" cy="280" r="7" class="f-a pop"/><circle cx="900" cy="60" r="12" class="f-a pop"/><text x="874" y="68" text-anchor="end" class="tx tx-a tx-b t48 tx-l pop">2¹⁰ = 1024</text><text x="916" y="120" text-anchor="start" class="tx tx-a tx-b t32 fade">乘法</text></svg></div>
